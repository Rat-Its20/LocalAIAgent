<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="Window.Base" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource CopilotBackground}" />
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="WindowStyle" Value="None" />
    </Style>

    <Style
        x:Key="MainWindow.Style"
        BasedOn="{StaticResource Window.Base}"
        TargetType="{x:Type Window}">
        <Setter Property="Height" Value="{StaticResource MainWindow.Height}" />
        <Setter Property="Width" Value="{StaticResource MainWindow.Width}" />
        <Setter Property="MinHeight" Value="{StaticResource MainWindow.Height}" />
        <Setter Property="MinWidth" Value="{StaticResource MainWindow.Width}" />
    </Style>

    <Style
        x:Key="ModelSettingWindow.Style"
        BasedOn="{StaticResource Window.Base}"
        TargetType="{x:Type Window}">
        <Setter Property="Height" Value="{StaticResource ModelSettingWindow.Height}" />
        <Setter Property="Width" Value="{StaticResource ModelSettingWindow.Width}" />
        <Setter Property="MinHeight" Value="{StaticResource ModelSettingWindow.Height}" />
        <Setter Property="MinWidth" Value="{StaticResource ModelSettingWindow.Width}" />
    </Style>

    <Style
        x:Key="DialogWindow.Style"
        BasedOn="{StaticResource Window.Base}"
        TargetType="{x:Type Window}">
        <Setter Property="Height" Value="{StaticResource DialogWindow.Height}" />
        <Setter Property="Width" Value="{StaticResource DialogWindow.Width}" />
        <Setter Property="MinHeight" Value="{StaticResource DialogWindow.Height}" />
        <Setter Property="MinWidth" Value="{StaticResource DialogWindow.Width}" />
        <Setter Property="AllowsTransparency" Value="True" />
    </Style>

    <Style x:Key="Grid.Column5" TargetType="{x:Type ColumnDefinition}">
        <Setter Property="Width" Value="5" />
    </Style>

    <Style x:Key="Grid.Row5" TargetType="{x:Type RowDefinition}">
        <Setter Property="Height" Value="5" />
    </Style>

    <Style x:Key="Window.Border" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="48" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{StaticResource CopilotSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource CopilotBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="{x:Type Control}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
    </Style>

    <Style TargetType="{x:Type ComboBox}">
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="Background" Value="{StaticResource CopilotSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource CopilotBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Opacity="0.25"
                                ShadowDepth="2"
                                Color="#000000" />
                        </Border.Effect>

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#333333" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#2A2A2A" />
            </Trigger>

            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#66FFFFFF" />
                <Setter Property="Background" Value="#1AFFFFFF" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource CopilotBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="FontSize" Value="{StaticResource BaseFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid>
                        <!--  外枠  -->
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ContentPresenter />
                        </Border>

                        <!--  タイトル  -->
                        <Border
                            Margin="12,-8,0,0"
                            Padding="6,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="Transparent"
                            CornerRadius="4">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="{TemplateBinding FontSize}"
                                FontWeight="SemiBold"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Header}"
                                TextTrimming="None" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="#66FFFFFF" />
                <Setter Property="BorderBrush" Value="#33FFFFFF" />
            </Trigger>
        </Style.Triggers>
    </Style>



</ResourceDictionary>