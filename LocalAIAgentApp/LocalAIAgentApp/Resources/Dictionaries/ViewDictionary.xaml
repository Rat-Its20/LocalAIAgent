<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Style x:Key="Window.Base" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{StaticResource CopilotBackground}" />
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="ResizeMode" Value="CanResizeWithGrip" />
        <Setter Property="WindowStyle" Value="None" />
    </Style>

    <Style
        x:Key="MainWindow.Style"
        BasedOn="{StaticResource Window.Base}"
        TargetType="{x:Type Window}">
        <Setter Property="Height" Value="{StaticResource MainWindow.Height}" />
        <Setter Property="Width" Value="{StaticResource MainWindow.Width}" />
        <Setter Property="MinHeight" Value="{StaticResource MainWindow.Height}" />
        <Setter Property="MinWidth" Value="{StaticResource MainWindow.Width}" />
    </Style>

    <Style
        x:Key="ModelSettingWindow.Style"
        BasedOn="{StaticResource Window.Base}"
        TargetType="{x:Type Window}">
        <Setter Property="Height" Value="{StaticResource ModelSettingWindow.Height}" />
        <Setter Property="Width" Value="{StaticResource ModelSettingWindow.Width}" />
        <Setter Property="MinHeight" Value="{StaticResource ModelSettingWindow.Height}" />
        <Setter Property="MinWidth" Value="{StaticResource ModelSettingWindow.Width}" />
    </Style>

    <Style x:Key="Grid.Column5" TargetType="{x:Type ColumnDefinition}">
        <Setter Property="Width" Value="5" />
    </Style>

    <Style x:Key="Grid.Row5" TargetType="{x:Type RowDefinition}">
        <Setter Property="Height" Value="5" />
    </Style>

    <Style x:Key="Window.Border" TargetType="{x:Type Border}">
        <Setter Property="Height" Value="48" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{StaticResource CopilotSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource CopilotBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style TargetType="{x:Type Control}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="{x:Type TextBox}">
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="{x:Type Label}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="{x:Type CheckBox}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="{x:Type RadioButton}">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CopilotText}" />
        <Setter Property="Background" Value="{StaticResource CopilotSurface}" />
        <Setter Property="BorderBrush" Value="{StaticResource CopilotBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Opacity="0.25"
                                ShadowDepth="2"
                                Color="#000000" />
                        </Border.Effect>

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#333333" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#2A2A2A" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>