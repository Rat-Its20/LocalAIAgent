<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="MainWindow.Width">1280</sys:Double>
    <sys:Double x:Key="MainWindow.Height">768</sys:Double>

    <sys:Double x:Key="ModelSettingWindow.Width">650</sys:Double>
    <sys:Double x:Key="ModelSettingWindow.Height">450</sys:Double>

    <Color x:Key="CopilotBackgroundColor">#FF1E1E1E</Color>
    <Color x:Key="CopilotSurfaceColor">#FF2A2A2A</Color>
    <Color x:Key="CopilotBorderColor">#FF3A3A3A</Color>
    <Color x:Key="CopilotTextColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="CopilotBackground" Color="{StaticResource CopilotBackgroundColor}" />
    <SolidColorBrush x:Key="CopilotSurface" Color="{StaticResource CopilotSurfaceColor}" />
    <SolidColorBrush x:Key="CopilotBorder" Color="{StaticResource CopilotBorderColor}" />
    <SolidColorBrush x:Key="CopilotText" Color="{StaticResource CopilotTextColor}" />

    <SolidColorBrush x:Key="MaterialDesignBody" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MaterialDesignHeadline" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MaterialDesignSubtitle" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="MaterialDesignButtonForeground" Color="#FFFFFFFF" />

</ResourceDictionary>