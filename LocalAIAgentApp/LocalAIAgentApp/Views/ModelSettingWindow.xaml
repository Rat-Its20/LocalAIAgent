<Window
    x:Class="LocalAIAgentApp.Views.ModelSettingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:LocalAIAgentApp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:LocalAIAgentApp.Resources.Languages"
    Style="{StaticResource ModelSettingWindow.Style}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  タイトルバー  -->
        <Border Grid.Row="0" Style="{StaticResource Window.Border}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左側：アプリ名  -->
                <StackPanel
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="{x:Static properties:Resources.ModelSettingWindow_Title}" />
                </StackPanel>

                <!--  右側：ウィンドウボタン  -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        Width="48"
                        Background="Transparent"
                        BorderThickness="0"
                        Command="{Binding CloseCommand}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Text="×" />
                    </Button>
                </StackPanel>
            </Grid>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding TitleBarMouseLeftDownCommand}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

        </Border>

        <!--  メインコンテンツ  -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Style="{StaticResource Grid.Row5}" />
                <RowDefinition Height="Auto" />
                <RowDefinition Style="{StaticResource Grid.Row5}" />
                <RowDefinition Height="*" />
                <RowDefinition Style="{StaticResource Grid.Row5}" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  作業ディレクトリ  -->
            <GroupBox Grid.Row="0" Header="作業ディレクトリの設定">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="作業ディレクトリを選択してください。" />
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Style="{StaticResource Grid.Column5}" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding WorkDirectory.Value}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding ReferenceCommand}"
                            Content="{x:Static properties:Resources.Common_Reference}" />
                    </Grid>
                </Grid>
            </GroupBox>

            <GroupBox
                Grid.Row="2"
                Padding="0,15,0,0"
                Header="モデル設定"
                IsEnabled="{Binding IsEnableModelSettingGroup.Value}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Style="{StaticResource Grid.Row5}" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  モデルの読み込み  -->
                    <GroupBox Grid.Row="0" Header="モデルの選択">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0" Content="利用するモデルを選択してください。" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Style="{StaticResource Grid.Column5}" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    Grid.Row="0"
                                    IsEnabled="{Binding IsEnableModelAliasCollection.Value}"
                                    ItemsSource="{Binding ModelAliasCollection}"
                                    SelectedValue="{Binding SelectedModelAlias.Value}" />
                                <Button
                                    Grid.Column="2"
                                    Command="{Binding AliasLoadCommand}"
                                    Content="読込"
                                    IsEnabled="{Binding IsEnableReferenceButton.Value}" />
                            </Grid>
                        </Grid>
                    </GroupBox>

                </Grid>
            </GroupBox>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Grid.Column="2"
                    Command="{Binding SaveCommand}"
                    Content="{x:Static properties:Resources.Common_Save}"
                    IsEnabled="{Binding IsEnableSaveButton.Value}" />
            </Grid>
        </Grid>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
</Window>
