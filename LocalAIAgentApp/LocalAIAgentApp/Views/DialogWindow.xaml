<Window
    x:Class="LocalAIAgentApp.Views.DialogWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:LocalAIAgentApp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Style="{StaticResource DialogWindow.Style}"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Border Style="{StaticResource DialogWindow.Border}">

        <StackPanel VerticalAlignment="Center">

            <!--  メッセージ  -->
            <TextBlock
                d:Text="Loding..."
                Style="{StaticResource DialogWindow.TextBlock}"
                Text="{Binding Message.Value}" />

            <!--  プログレスバー（角丸なし）  -->
            <ProgressBar IsIndeterminate="True" Style="{StaticResource ProgressBar.Style}" />

        </StackPanel>
    </Border>

</Window>
