<Window
    x:Class="LocalAIAgentApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:LocalAIAgentApp.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:page="clr-namespace:LocalAIAgentApp.Views.Pages"
    xmlns:pagevm="clr-namespace:LocalAIAgentApp.ViewModels.Pages"
    xmlns:properties="clr-namespace:LocalAIAgentApp.Resources.Languages"
    Title="{x:Static properties:Resources.ApplicationTitle}"
    Style="{StaticResource MainWindow.Style}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  タイトルバー  -->
        <Border Grid.Row="0" Style="{StaticResource Window.Border}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  左側：アプリ名  -->
                <Grid Grid.Column="0" Style="{StaticResource Window.HeaderLeft.Grid}">
                    <TextBlock Style="{StaticResource Window.HeaderLeft.TextBlock}" Text="{x:Static properties:Resources.ApplicationTitle}" />
                </Grid>

                <!--  右側：ウィンドウボタン  -->
                <StackPanel Grid.Column="1" Style="{StaticResource Window.HeaderRight.StackPanel}">
                    <Button Command="{Binding MinimizeCommand}" Style="{StaticResource Window.HeaderRight.Button}">
                        <TextBlock Style="{StaticResource Window.HeaderRight.TextBlock}" Text="─" />
                    </Button>

                    <Button Command="{Binding MaximizeCommand}" Style="{StaticResource Window.HeaderRight.Button}">
                        <TextBlock Style="{StaticResource Window.HeaderRight.TextBlock}" Text="□" />
                    </Button>

                    <Button Command="{Binding CloseCommand}" Style="{StaticResource Window.HeaderRight.Button}">
                        <TextBlock Style="{StaticResource Window.HeaderRight.TextBlock}" Text="×" />
                    </Button>
                </StackPanel>
            </Grid>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseLeftButtonDown">
                    <i:InvokeCommandAction Command="{Binding TitleBarMouseLeftDownCommand}" PassEventArgsToCommand="True" />
                </i:EventTrigger>
            </i:Interaction.Triggers>

        </Border>

        <!--  メインコンテンツ  -->
        <Grid Grid.Row="1" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{StaticResource Grid.Column5}" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <page:ChatControl Grid.Column="2" DataContext="{Binding ChatControlViewModel.Value}" />
        </Grid>
    </Grid>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

</Window>
