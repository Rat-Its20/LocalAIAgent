<UserControl
    x:Class="LocalAIAgentApp.Views.Pages.ChatControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:LocalAIAgentApp.Views.Pages"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:properties="clr-namespace:LocalAIAgentApp.Resources.Languages"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Style="{StaticResource Grid.Row5}" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="6"
                            Padding="8"
                            Background="#333333"
                            CornerRadius="8">
                            <TextBlock
                                Foreground="White"
                                Text="{Binding Text}"
                                TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--  送信エリア  -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Style="{StaticResource Grid.Column5}" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Grid.Column="0"
                IsEnabled="{Binding IsEnableSendMessageTextBox.Value}"
                Text="{Binding SendMessageTextBox.Value}" />
            <Button
                Grid.Column="2"
                Command="{Binding SendMessageCommand}"
                Content="送信"
                IsEnabled="{Binding IsEnableSendButton.Value}" />
        </Grid>

    </Grid>
</UserControl>
